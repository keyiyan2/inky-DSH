{
  "name": "@local/dsh-ink",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ink 写作面板：在 DSH 里写 inkle/ink 台词，用下拉选择 #speaker/#portrait/#layout 标签，保存即写入 Inky 项目并由 Inky 热更新。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/keyiyan2/inky-DSH.git"
  },
  "homepage": "https://github.com/keyiyan2/inky-DSH#readme",
  "keywords": [
    "dsh",
    "ink",
    "inkle",
    "writing",
    "cordis-plugin"
  ],
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/inkjs/*",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
