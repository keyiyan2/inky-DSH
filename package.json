{
  "name": "inky-dsh",
  "version": "0.1.21",
  "type": "module",
  "description": "Ink 写作面板：在 DSH 里写 inkle/ink 台词，用下拉选择 #speaker/#portrait/#layout 标签，保存即写入 Inky 项目并由 Inky 热更新。",
  "license": "MIT",
  "author": "keyiyan2",
  "repository": {
    "type": "git",
    "url": "https://github.com/keyiyan2/inky-DSH.git"
  },
  "homepage": "https://github.com/keyiyan2/inky-DSH#readme",
  "bugs": {
    "url": "https://github.com/keyiyan2/inky-DSH/issues"
  },
  "keywords": [
    "dsh",
    "ink",
    "inkle",
    "writing",
    "cordis-plugin",
    "inky"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --check index.js && node --check client.js && node --check preload.cjs",
    "prepublishOnly": "node --check index.js && node --check client.js && node --check preload.cjs"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "preload.cjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon.png",
    "vendor/inkjs/*",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
